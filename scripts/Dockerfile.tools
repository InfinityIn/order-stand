# Образ с инструментами приёмки: генератор нагрузки и чекер сохранности.
# Сборка:  docker build -f scripts/Dockerfile.tools -t order-stand-tools scripts/
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY load.py check.py ./

ENTRYPOINT ["python"]
