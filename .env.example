# Скопируйте в .env и правьте под себя.

POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders

# Внутри compose-сети
DATABASE_URL=postgresql://orders:orders@postgres:5432/orders
KAFKA_BOOTSTRAP=kafka:9092

# Для запуска scripts/*.py с хоста
# DATABASE_URL=postgresql://orders:orders@localhost:5432/orders

ORDERS_TOPIC=orders
CONSUMER_GROUP=order-worker
METRICS_PORT=8001
